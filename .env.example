# Apify: scrapes public LinkedIn + Instagram profiles
APIFY_API_TOKEN=
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-profile-scraper
APIFY_INSTAGRAM_ACTOR=apify/instagram-profile-scraper

# OpenRouter: persona agents, judge, profile analysis
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash

# Storage: Turso (libsql://...) in production, local SQLite file in dev
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_URL=file:data/app.db

# Dating harness
MAX_TURNS=12            # hard-capped at 25 in code
SESSION_SECRET=change-me
DATES_PER_AGENT=4       # dates each agent goes on
